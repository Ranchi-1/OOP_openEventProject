              <mxPoint x="990" y="1090" />
              <mxPoint x="1020" y="1090" />
              <mxPoint x="1020" y="1080" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note" value="Event is abstract; calculatePrice is concrete and shared. Concert, SportsMatch and MovieScreening implement eventType and experienceLabel. Event.hostId identifies its owning Host. Legacy Section groups seats by offer code. The optional flexible plan is expanded on the next page. Seat states are AVAILABLE / SOLD; ticket states determine active ownership. Other getters are omitted. Hollow diamonds denote shared aggregation of reusable value objects; they do not claim automatic Java object deletion. Relation counts read source to target." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1379.0" width="1460" height="100" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
