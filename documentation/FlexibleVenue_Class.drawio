<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram name="Flexible venue model">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1600">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenEvent · Flexible venue and ticket type extension" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1000" height="50" />
        </mxCell>
        <mxCell id="layout" value="&lt;b&gt;VenueLayout&lt;/b&gt;&lt;hr&gt;- plan: VenuePlan [0..1]&lt;br&gt;- seats: List&amp;lt;Seat&amp;gt;&lt;hr&gt;+ isFlexible(): boolean&lt;br&gt;+ getPlan(): VenuePlan" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=14;fillColor=#F3EEFF;strokeColor=#6550A0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="110" width="290" height="230" />
        </mxCell>
        <mxCell id="plan" value="&lt;b&gt;VenuePlan&lt;/b&gt;&lt;hr&gt;- stage: Stage&lt;br&gt;- areas: List&amp;lt;VenueArea&amp;gt;&lt;br&gt;- types: List&amp;lt;TicketType&amp;gt;&lt;hr&gt;+ createSeats(): List&amp;lt;Seat&amp;gt;&lt;br&gt;+ getType(code): TicketType" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=14;fillColor=#F3EEFF;strokeColor=#6550A0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="400" y="110" width="290" height="230" />
        </mxCell>
        <mxCell id="stage" value="&lt;b&gt;Stage&lt;/b&gt;&lt;hr&gt;- x, y: int&lt;br&gt;- width, height: int&lt;hr&gt;+ getBounds(): Rectangle" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=14;fillColor=#F3EEFF;strokeColor=#6550A0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="110" width="290" height="230" />
        </mxCell>
        <mxCell id="area" value="&lt;b&gt;VenueArea&lt;/b&gt;&lt;hr&gt;- code, name: String&lt;br&gt;- typeCode: String&lt;br&gt;- x, y, width, height: int&lt;br&gt;- rows, columns, rowOffset: int&lt;br&gt;- shape: String&lt;br&gt;- blocked: Set&amp;lt;String&amp;gt;&lt;hr&gt;+ isBlocked(row, column): boolean" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=14;fillColor=#F3EEFF;strokeColor=#6550A0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="440" width="290" height="230" />
        </mxCell>
        <mxCell id="type" value="&lt;b&gt;TicketType&lt;/b&gt;&lt;hr&gt;- code, name: String&lt;br&gt;- price: BigDecimal&lt;br&gt;- color: String&lt;br&gt;- earlyBird: boolean&lt;hr&gt;+ getPrice(): BigDecimal&lt;br&gt;+ hasEarlyBird(): boolean" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=14;fillColor=#F3EEFF;strokeColor=#6550A0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="420" y="440" width="290" height="230" />
        </mxCell>
        <mxCell id="seat" value="&lt;b&gt;Seat&lt;/b&gt;&lt;hr&gt;- id: long&lt;br&gt;- row, column: int&lt;br&gt;- label, status: String&lt;br&gt;- areaCode: String&lt;br&gt;- ticketType: TicketType [0..1]&lt;hr&gt;+ isAvailable(): boolean&lt;br&gt;+ getTypeCode(): String" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=14;fillColor=#F3EEFF;strokeColor=#6550A0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="820" y="440" width="290" height="230" />
        </mxCell>
        <mxCell id="ticket" value="&lt;b&gt;Ticket&lt;/b&gt;&lt;hr&gt;- category: String {snapshot}&lt;br&gt;- amount: BigDecimal {snapshot}&lt;br&gt;- seatLabel, code, status: String&lt;hr&gt;Purchased values survive offer edits" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=14;fillColor=#F3EEFF;strokeColor=#6550A0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="820" y="820" width="290" height="230" />
        </mxCell>
        <mxCell id="repo" value="&lt;b&gt;BookingRepository&lt;/b&gt;&lt;hr&gt;+ saveEvent(session,event,layout,replace)&lt;br&gt;+ updateTicketTypes(session,eventId,types)&lt;br&gt;+ purchase(session,request)&lt;hr&gt;Ownership, event lock, rollback, commit" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=14;fillColor=#F3EEFF;strokeColor=#6550A0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="820" width="290" height="230" />
        </mxCell>
        <mxCell id="pr" value="&lt;b&gt;VenuePlanRepository&lt;/b&gt;&lt;hr&gt;+ read(connection,eventId): VenuePlan&lt;br&gt;+ save(connection,eventId,plan)&lt;br&gt;+ updateTypes(connection,eventId,types)&lt;hr&gt;Uses caller transaction" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Arial;fontSize=14;fillColor=#F3EEFF;strokeColor=#6550A0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="420" y="820" width="290" height="230" />
        </mxCell>
        <mxCell id="e0" value="1 → 0..1" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="layout" target="plan">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="1 stage" style="startArrow=diamond;startFill=1;endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="plan" target="stage">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e2" value="1..12 sections" style="startArrow=diamond;startFill=1;endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="plan" target="area">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e3" value="1..20 offers" style="startArrow=diamond;startFill=1;endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="plan" target="type">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e4" value="many areas → 1 offer (code)" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="area" target="type">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e5" value="1..1200 seats" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="layout" target="seat">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e6" value="0..1 custom offer" style="endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="seat" target="type">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e7" value="uses" style="dashed=1;endArrow=open;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="repo" target="pr">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e8" value="0..* ticket records → 0..1 saved seat" style="endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="ticket" target="seat">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="note" value="VenueArea = physical section. Legacy Section groups seats by offer code. Event/Payment inheritance remains in the original diagrams." style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1110" width="1200" height="100" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>