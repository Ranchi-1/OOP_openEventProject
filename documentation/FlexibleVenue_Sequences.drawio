            <mxPoint as="targetPoint" x="960" y="360" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="4. Current display price" style="dashed=1;endArrow=open;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="960" y="440" />
            <mxPoint as="targetPoint" x="540" y="440" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="5. Confirm simulated checkout" style="endArrow=block;endFill=1;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
