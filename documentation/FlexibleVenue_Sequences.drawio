          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="750" y="760" />
            <mxPoint as="targetPoint" x="1170" y="760" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="9. Validate offer; calculate price; simulate payment" style="endArrow=block;endFill=1;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="750" y="840" />
            <mxPoint as="targetPoint" x="960" y="840" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="10. Payment reference or failure" style="dashed=1;endArrow=open;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="960" y="920" />
            <mxPoint as="targetPoint" x="750" y="920" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="11. Save ticket name/amount snapshot, payment and receipt; COMMIT" style="endArrow=block;endFill=1;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="750" y="1000" />
            <mxPoint as="targetPoint" x="1170" y="1000" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m11" value="12. Saved Ticket after commit" style="dashed=1;endArrow=open;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="750" y="1080" />
            <mxPoint as="targetPoint" x="540" y="1080" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" value="13. Show ticket and receipt" style="dashed=1;endArrow=open;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="540" y="1160" />
            <mxPoint as="targetPoint" x="120" y="1160" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note" value="Customer cannot substitute a cheaper offer. An eligible Early Bird offer receives 20% off before cutoff. Failed payment or SQL writes roll back the seat claim. Future renames/repricing do not change purchased ticket snapshots. Existing cancellation and check-in sequences still apply." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=12;fillColor=#FFF2CC;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="1320" width="1160" height="110" />
        </mxCell>
