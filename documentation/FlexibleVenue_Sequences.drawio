        <mxCell id="p3" value="&lt;b&gt;BookingRepository&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#F3EEFF;" vertex="1" parent="1">
