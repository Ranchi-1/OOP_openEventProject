            <mxPoint as="targetPoint" x="1170" y="1210" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m0" value="1. Select template; edit sections, stage and ticket offers" style="endArrow=block;endFill=1;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="120" y="200" />
            <mxPoint as="targetPoint" x="330" y="200" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m1" value="2. Construct validated plan; reject overlap / invalid bounds" style="endArrow=block;endFill=1;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="330" y="280" />
            <mxPoint as="targetPoint" x="540" y="280" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="3. Save event" style="endArrow=block;endFill=1;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="120" y="360" />
            <mxPoint as="targetPoint" x="330" y="360" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="4. OpenEventUI calls saveEvent(session,event,layout,replace)" style="endArrow=block;endFill=1;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="330" y="440" />
            <mxPoint as="targetPoint" x="750" y="440" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="5. BEGIN; lock event; verify owner and active tickets" style="endArrow=block;endFill=1;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="750" y="520" />
            <mxPoint as="targetPoint" x="1170" y="520" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="6. Owner + current booking state" style="dashed=1;endArrow=open;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="1170" y="600" />
            <mxPoint as="targetPoint" x="750" y="600" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="7. [unbooked] save event, offers and generated seats" style="endArrow=block;endFill=1;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="750" y="680" />
            <mxPoint as="targetPoint" x="1170" y="680" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="8. Save overview / offer metadata using same connection" style="endArrow=block;endFill=1;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="750" y="760" />
            <mxPoint as="targetPoint" x="960" y="760" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="9. Persist stage, areas and custom ticket details" style="endArrow=block;endFill=1;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="960" y="840" />
            <mxPoint as="targetPoint" x="1170" y="840" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="10. COMMIT all changes together" style="endArrow=block;endFill=1;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="750" y="920" />
            <mxPoint as="targetPoint" x="1170" y="920" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="11. Saved event id (through OpenEventUI)" style="dashed=1;endArrow=open;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="750" y="1000" />
            <mxPoint as="targetPoint" x="330" y="1000" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m11" value="12. Show saved event" style="dashed=1;endArrow=open;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="330" y="1080" />
            <mxPoint as="targetPoint" x="120" y="1080" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note" value="If active tickets exist, geometry and seat assignment changes are rejected. Offer names, colors and future prices may change. Any failed write rolls back the whole save. OpenEventUI owns the asynchronous request and result display." style="shape=note;whiteSpace=wrap;html=1;align=left;spacing=12;fillColor=#FFF2CC;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="1240" width="1160" height="110" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Customer selects a section and purchases a custom ticket">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1600">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
