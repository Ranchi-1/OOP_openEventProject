        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;Event / Payment&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#F3EEFF;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="875" y="90" width="170" height="60" />
        </mxCell>
        <mxCell id="l4" style="dashed=1;endArrow=none;strokeColor=#777777;" edge="1" parent="1">
