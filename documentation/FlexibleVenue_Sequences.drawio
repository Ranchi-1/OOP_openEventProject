            <mxPoint as="sourcePoint" x="120" y="520" />
            <mxPoint as="targetPoint" x="540" y="520" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="6. BookingController → BookingSystem → purchase" style="endArrow=block;endFill=1;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="540" y="600" />
            <mxPoint as="targetPoint" x="750" y="600" />
